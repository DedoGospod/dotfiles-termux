#!/usr/bin/env bash

# Configuration
TARGET_IP="192.168.1.102"
TARGET_MAC="A0:AD:9F:CD:AC:A8"
REMOTE_USER="dylan"
OPENWRT_IP="192.168.1.30"
MAX_BOOT_WAIT_SECONDS=120

# Hardened SSH Options:
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new"

# Dependency Validation
REQUIRED_CMDS=("ssh" "nc")
for cmd in "${REQUIRED_CMDS[@]}"; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        printf "Error: Required command '%s' is not installed.\n" "$cmd" >&2
        exit 1
    fi
done

# Check if the target is already awake
if nc -z -w 1 "$TARGET_IP" 22 2>/dev/null; then
    printf "Target machine %s is already awake...\n" "$TARGET_IP"
else
    # Wake the target machine
    printf "Waking PC (%s)...\n" "$TARGET_IP"
    if ! ssh $SSH_OPTS "root@$OPENWRT_IP" "etherwake -i br-lan $TARGET_MAC"; then
        printf "Error: Failed to send Wake-on-LAN packet via OpenWrt.\n" >&2
        exit 1
    fi

    # Wait for SSH to become available
    RETRY_COUNT=0
    printf "Waiting for boot "
    until nc -z -w 1 "$TARGET_IP" 22 2>/dev/null || [ "$RETRY_COUNT" -eq "$MAX_BOOT_WAIT_SECONDS" ]; do
        printf "."
        sleep 1
        RETRY_COUNT=$((RETRY_COUNT + 1))
    done
    printf "\n"

    if [[ "$RETRY_COUNT" -eq "$MAX_BOOT_WAIT_SECONDS" ]]; then
        printf "Error: Timeout waiting for %s port 22.\n" "$TARGET_IP" >&2
        exit 1
    fi
fi

# Execute remote payload
printf "Launching gamemode...\n"
if ! ssh -t $SSH_OPTS "$REMOTE_USER@$TARGET_IP" "sudo -v && systemctl --user start sunshine.service && sudo chvt 2; then
    printf "Error: Failed to execute gamemode script.\n" >&2
    exit 1
fi

printf "Success.\n"
